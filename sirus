CombatTab:CreateSection("Bullet Tracer")

local holding = false
local TracersEnabled = false
local TracerColor = Color3.fromRGB(255, 0, 0)

local function createTracer(origin, target)
    if not TracersEnabled then return end

    local tracer = Instance.new("Part")
    tracer.Anchored = true
    tracer.CanCollide = false
    tracer.Size = Vector3.new(0.1, 0.1, (origin - target).Magnitude)
    tracer.CFrame = CFrame.new((origin + target) / 2, target)
    tracer.Color = TracerColor
    tracer.Material = Enum.Material.Neon
    tracer.Parent = Workspace

    task.spawn(function()
        for i = 1, 20 do
            tracer.Transparency = i / 20
            task.wait(0.02)
        end
        tracer:Destroy()
    end)
end

local function fireTracer()
    if not TracersEnabled then return end

    local character = LocalPlayer.Character
    if not character then return end

    local gun = character:FindFirstChildWhichIsA("Tool")
    if not gun then return end

    local muzzle = gun:FindFirstChild("Muzzle") or gun:FindFirstChild("Handle")
    if not muzzle then return end

    local origin
    if muzzle.Name == "Muzzle" then
        origin = muzzle.Position
    else
        origin = muzzle.Position + muzzle.CFrame.LookVector * (muzzle.Size.Z / 2)
    end

    createTracer(origin, Mouse.Hit.Position)
end

Mouse.Button1Down:Connect(function()
    if not TracersEnabled then return end
    holding = true
    fireTracer()

    task.spawn(function()
        while holding and TracersEnabled do
            fireTracer()
            task.wait(0.1)
        end
    end)
end)

Mouse.Button1Up:Connect(function()
    holding = false
end)

